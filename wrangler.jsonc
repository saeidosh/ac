{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ac",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8ad18323-1f51-43b0-a8b8-a9203cf88959","database_name": "ac" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8740f838f22e4ef49bad60da2dc79fec" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
